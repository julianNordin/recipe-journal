# Copy to .env and fill in. src/env.ts validates all of this at boot, so a
# missing or malformed value stops the process rather than surfacing later as
# a 500 on whichever request happened to need it first.

# Postgres. Matches docker-compose.yml from phase 03 onward.
DATABASE_URL="postgresql://recipe:recipe@localhost:5432/recipe_journal"

# Signs and encrypts the session cookie. Minimum 32 characters, enforced.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-at-least-thirty-two-characters"
NEXTAUTH_URL="http://localhost:3000"

# Optional. Leave both unset to run without GitHub sign-in; setting only one
# is rejected at boot. Register an OAuth app with the callback URL
# http://localhost:3000/api/auth/callback/github
# GITHUB_ID=""
# GITHUB_SECRET=""
